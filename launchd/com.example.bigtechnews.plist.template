<?xml version="1.0" encoding="UTF-8"?>
<!--
    Daily Techmeme fetch job for big-tech-news.

    To install:
      1. Copy this file to ~/Library/LaunchAgents/, dropping the `.template`
         extension and changing the `com.example.` prefix to your own
         reverse-DNS prefix (e.g. `com.yourname.bigtechnews.plist`).
      2. Replace every occurrence of {{REPO}} with the absolute path to your
         clone of this repo (e.g. /Users/you/Repositories/big-tech-news).
      3. launchctl load ~/Library/LaunchAgents/com.yourname.bigtechnews.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.bigtechnews</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{REPO}}/.venv/bin/python</string>
        <string>{{REPO}}/fetch.py</string>
        <string>--days</string>
        <string>2</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO}}</string>

    <!-- Run every day at 06:00 local time (captures prior day + overnight) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 06:00, run as soon as it wakes -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{REPO}}/launchd/fetch.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO}}/launchd/fetch.err.log</string>
</dict>
</plist>
